{
  "author": "riya-amemiya",
  "bugs": {
    "url": "https://github.com/riya-amemiya/UMT/issues"
  },
  "description": "個人的に作った便利関数集 個人用途なので破壊的変更がある可能性があります。 Main Packageに依存関係はありません。 JavaScriptからの呼び出しに対応しています。",
  "devDependencies": {
    "@babel/cli": "8.0.4",
    "@babel/core": "8.0.1",
    "@babel/preset-env": "8.0.2",
    "@babel/preset-typescript": "8.0.1",
    "@biomejs/biome": "2.5.11",
    "@eslint/js": "10.0.1",
    "@swc/core": "1.16.1",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.25",
    "@types/node": "26.4.0",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "bun-types": "1.4.0",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.9.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-unicorn": "74.0.0",
    "gh-pages": "6.3.0",
    "jest": "30.5.0",
    "lodash": "4.18.1",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "tsc-alias": "1.9.2",
    "typedoc": "0.28.20",
    "typescript": "6.0.3"
  },
  "directories": {
    "doc": "doc",
    "lib": "lib",
    "test": "tests"
  },
  "files": [
    "module",
    "!module/tests",
    "!module/tsconfig.tsbuildinfo"
  ],
  "homepage": "https://github.com/riya-amemiya/UMT#readme",
  "keywords": [],
  "license": "MIT",
  "main": "module/index.js",
  "name": "umt-i18n",
  "repository": {
    "type": "git",
    "url": "git://github.com/riya-amemiya/UMT.git"
  },
  "scripts": {
    "build": "tsc && tsc-alias -p tsconfig.json",
    "build:babel": "babel src --extensions '.ts' --out-dir module/es5 && tsc --emitDeclarationOnly --outDir module/es5",
    "build:full": "bun run build && bun build:babel",
    "build:clean": "rm -rf module && bun build",
    "build:clean:full": "rm -rf module && bun build:full",
    "clean-build": "rm -rf module && bun build",
    "deploy": "bun typedoc && gh-pages -d doc",
    "eslint": "eslint src",
    "format": "biome format . --write",
    "lint": "bun eslint --fix && biome check . --write && tsc",
    "lint:ci": "bun eslint && biome ci . && tsc",
    "test": "jest",
    "test-debug": "cd test && tsc",
    "ts-node": "bun run build && ts-node --project tmp/tsconfig.json tmp/src/index.ts"
  },
  "type": "module",
  "types": "module/index.d.js",
  "version": "1.1.1",
  "dependencies": {
    "umt": "5.0.0"
  }
}
